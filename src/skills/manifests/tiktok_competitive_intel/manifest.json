{
  "name": "tiktok_competitive_intel",
  "description": "TikTok Shop competitive intelligence agent for Malaysia/SEA cross-border e-commerce. Monitors competitor pricing, real-time sales velocity, ad campaign creatives, and fraud/risk signals for Shopee, Lazada, and TikTok Shop native stores. Returns structured JSON with competitor_metrics, fraud_risk_score, and actionable recommendations.",
  "input_schema": {
    "type": "object",
    "properties": {
      "keyword": {
        "type": "string",
        "description": "Product keyword or ASIN/SKU to analyse (e.g. '马来女生护肤', 'electrical kitchen gadgets MY')"
      },
      "market": {
        "type": "string",
        "enum": ["malaysia", "indonesia", "thailand", "vietnam", "philippines", "singapore"],
        "description": "Target SEA market (default: malaysia). ISO country-level scope for price comparison."
      },
      "platforms": {
        "type": "array",
        "items": { "type": "string", "enum": ["tiktok_shop", "shopee", "lazada"] },
        "description": "Platforms to scan. Empty = all available."
      },
      "max_competitors": {
        "type": "integer",
        "description": "Max competing products to return per platform (default: 10, max: 50)"
      },
      "include_ad_creatives": {
        "type": "boolean",
        "description": "Fetch active ad campaign creatives for detected competitors (default: false)"
      },
      "fraud_screening": {
        "type": "boolean",
        "description": "Run fraud-risk heuristics on top listings (fake reviews, price outliers, stock manipulation). Default: true."
      }
    },
    "required": ["keyword"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": ["success", "partial", "error"],
        "description": "Execution status. 'partial' when some platforms returned data and others failed."
      },
      "keyword": { "type": "string", "description": "The original query keyword." },
      "market": { "type": "string", "description": "Target market code." },
      "scan_timestamp": { "type": "string", "description": "ISO-8601 timestamp of data collection." },
      "competitor_metrics": {
        "type": "object",
        "properties": {
          "total_products_scanned": { "type": "integer" },
          "avg_price_usd": { "type": "number" },
          "price_range": {
            "type": "object",
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" },
              "median": { "type": "number" }
            },
            "required": ["min", "max", "median"]
          },
          "avg_sales_velocity": { "type": "integer", "description": "Average units sold per day across all detected listings." },
          "top_competitors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rank": { "type": "integer" },
                "product_name": { "type": "string" },
                "platform": { "type": "string" },
                "price_usd": { "type": "number" },
                "sales_velocity": { "type": "integer", "description": "Est. units/day" },
                "rating": { "type": "number" },
                "review_count": { "type": "integer" },
                "seller_name": { "type": "string" },
                "seller_followers": { "type": "integer" },
                "ad_active": { "type": "boolean", "description": "Whether this competitor is currently running paid ads." },
                "ad_creatives": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of ad creative snippets/thumbnails if include_ad_creatives=true."
                },
                "listing_url": { "type": "string" }
              },
              "required": ["rank", "product_name", "platform", "price_usd", "sales_velocity", "rating", "seller_name"]
            }
          }
        },
        "required": ["total_products_scanned", "avg_price_usd", "avg_sales_velocity", "top_competitors"]
      },
      "fraud_risk_score": {
        "type": "object",
        "properties": {
          "overall_risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "suspicious_listings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_name": { "type": "string" },
                "risk_factors": { "type": "array", "items": { "type": "string" } },
                "confidence": { "type": "number", "description": "0.0–1.0" }
              },
              "required": ["product_name", "risk_factors", "confidence"]
            }
          },
          "price_anomaly_detected": { "type": "boolean" },
          "review_manipulation_flag": { "type": "boolean" }
        },
        "required": ["overall_risk", "suspicious_listings"]
      },
      "market_insights": {
        "type": "object",
        "properties": {
          "category_trend": { "type": "string", "description": "Short description of category trend direction." },
          "top_advertisers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seller_name": { "type": "string" },
                "est_monthly_ad_spend_usd": { "type": "number" },
                "active_campaigns": { "type": "integer" }
              },
              "required": ["seller_name", "est_monthly_ad_spend_usd"]
            }
          },
          "recommended_Price_range_usd": {
            "type": "object",
            "properties": {
              "suggested_min": { "type": "number" },
              "suggested_max": { "type": "number" },
              "rationale": { "type": "string" }
            },
            "required": ["suggested_min", "suggested_max"]
          }
        },
        "required": ["category_trend", "recommended_Price_range_usd"]
      },
      "raw_timestamp": { "type": "number", "description": "Unix epoch seconds of scan completion." }
    },
    "required": ["status", "keyword", "market", "competitor_metrics", "fraud_risk_score", "market_insights", "raw_timestamp"]
  },
  "version": "1.0.0",
  "author": "0x742d35Cc6634C0532925a3b844Bc9e7595f2bD18",
  "price_points": 5,
  "staked_points": 20.0,
  "tags": ["tiktok", "shopee", "lazada", "ecommerce", "competitive_intel", "sea", "malaysia", "ad_intelligence", "fraud_detection"],
  "agent_hint": "本技能用于东南亚跨境电商竞品情报分析。执行时需传入关键词和可选的市场/平台筛选参数。fraud_screening 默认开启，会消耗额外分析时间但提供防伪劣商家保护。建议搭配 aims-cli 的 Metered 模式按次付费使用。如果是 Subscription 用户可设置 rate_limit_per_day=500。Buyout 买断用户可获得永久许可证 + 无限调用。"
}
