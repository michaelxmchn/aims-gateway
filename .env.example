# AIMS Settlement — Deployment Environment Variables

# Required: deployer wallet private key (no 0x prefix)
DEPLOYER_PRIVATE_KEY=

# Base network RPC URLs (defaults provided if omitted)
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Immutable platform owner — recipient of 20% platform fees
# Set in the deployment script and burned into the contract bytecode
PLATFORM_OWNER=0x08c9fd0a915f2b0856353850b8adea943f226bcf

# Optional: contract address if reusing existing deployment
AIMS_CONTRACT_ADDRESS=
